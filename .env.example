# ============================================================
# Variáveis de ambiente — EXEMPLO (copie para .env e preencha)
# Nunca versione o .env real (já está no .gitignore).
# ============================================================

# --- Front-end ---
# A URL e a anon key do Supabase estão HARDCODED em js/config.js,
# pois o front é servido estático e não lê variáveis de ambiente.
# Para trocar de projeto, edite js/config.js diretamente.
# (A anon key é pública por design; a segurança depende do RLS.)

# --- Edge Function (servidor — definir no painel do Supabase) ---
# CORS_ORIGIN: domínio(s) permitidos para chamadas à API.
# Use a URL exata do front em produção; omitir libera qualquer origem (*).
# CORS_ORIGIN=https://seu-dominio.com

# SUPABASE_SERVICE_ROLE_KEY é injetada automaticamente pelo Supabase.
# NUNCA a exponha no front nem no repositório.

# --- CI/CD (NÃO vão para o navegador; configurar como Secrets no GitHub) ---
# Settings > Environments > production / staging
SUPABASE_ACCESS_TOKEN=token-pessoal-supabase
SUPABASE_PROJECT_REF=ref-do-projeto
SUPABASE_DB_PASSWORD=senha-do-banco
